# ── RescueHub (animal-rescue-app) environment ─────────────────────────────
# Copy this file to .env.local (runtime secrets) / .env (DATABASE_URL) and
# fill in real values. NEVER commit real secrets.

# PostgreSQL connection string used by Prisma. Also used at build time.
DATABASE_URL="postgresql://user:password@localhost:5432/rescuehub?schema=public"

# NextAuth v5 secret — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Sign-in resolves against users.passwordHash in Postgres. Create the two
# demo accounts (admin@rescuehub.org / staff@rescuehub.org) with:
#   npm run db:seed
#
# Optional dev-only escape hatch: accept the hardcoded demo credentials
# WITHOUT a seeded database. Ignored when NODE_ENV=production, so it can
# never weaken a deployed environment. Leave unset if you have seeded.
AUTH_ALLOW_MOCK_USERS=""

# Google Gemini API key — powers the public chatbot (api/chat),
# AI chat intake (api/chat-intake) and staff document scanning
# (api/shelter/intake/map). ⚠ Required — without it those features 500.
GOOGLE_GENERATIVE_AI_API_KEY=""

# Telegram bot — powers county/public intake notifications (src/lib/telegram.ts).
# ⚠ Required — without these, intake notification calls fail silently.
# Create a bot via @BotFather and put the chat/channel id here.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Canonical public origin (used by sitemap.xml / robots.txt / Open Graph).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Site mode. Anything other than "live" is a private preview: noindex,
# preview banner, and new accounts receive one 100-token search credit.
# Set to live only for the public launch.
NEXT_PUBLIC_SITE_MODE="preview"
