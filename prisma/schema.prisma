// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // Sprint A — point generated client at the package the Next.js app
  // actually resolves (`frontend/node_modules/@prisma/client`). The repo
  // previously generated to the monorepo root, leaving the frontend copy
  // stale (missing new fields) after every schema change.
  output = "../frontend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMERATIONS
// ============================================================

enum OrgType {
  MUNICIPAL_SHELTER
  FIVEC_3_RESCUE // 501(c)(3) Rescue
  CORPORATE_SPONSOR
}

enum MedState {
  HEALTHY_HOLD
  ISOLATION
  QUARANTINE
}

enum InType {
  PUBLIC_STRAY
  OWNER_SURRENDER
  MUNICIPAL_TRANSFER
}

enum FundType {
  MEDICAL
  GENERAL_CARE
  TRANSPORT
}

enum Trigger {
  ADOPTION_FINALIZED
  DONATION_MADE
  REFERRAL_SUCCESS
}

enum Render {
  NEUTRAL_ACKNOWLEDGMENT
}

// Adoption listing lifecycle. AVAILABLE animals appear on the public feed;
// HOLD mirrors a statutory hold; PENDING/ADOPTED remove them from it.
enum ListingStatus {
  AVAILABLE
  PENDING
  ADOPTED
  HOLD
}

// ============================================================
// EPIC 2 — Viral Token & Brand Sponsorship Gateway
// Enums: SharePlatform / VerificationStatus / TokenAction /
// TokenDirection / SponsorshipTxStatus / TokenWalletStatus.
// ============================================================

enum SharePlatform {
  FACEBOOK_GROUP
  NEXTDOOR
  SUBREDDIT
  WHATSAPP_GROUP
  INSTAGRAM_STORY
  GENERIC_LINK
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum TokenAction {
  // Earn reasons
  SHARE_10_GROUPS_EARN
  VOLUNTEER_HOUR_EARN
  REFERRAL_CONVERTED_EARN
  ONBOARDING_BONUS_EARN
  // Phase 3: Corporate-funded sponsor acknowledgment grant.
  // Value flows sponsor -> user. NOT ad-remuneration. UBIT IRC § 513(i)
  // attribution handled via the sponsorOrgId FK on TokenTransaction.
  SPONSOR_VIEW_CREDIT_EARN
  // Spend reasons
  SEARCH_FEE_WAIVE_SPEND
  PRIORITY_LISTING_SPEND
  PRINTED_FLYER_SPEND
  SHARE_BOOST_SPEND
  // Phase 3: Lost Pet Search service redemption (post-grant SPEND).
  LOST_PET_SEARCH_SPEND
  // Lifecycle
  EXPIRE_DEDUCT
  ADJUSTMENT_ADMIN
}

enum LostPetSearchStatus {
  SEARCHING
  FOUND
  CANCELLED
}

enum TokenDirection {
  EARN
  SPEND
  EXPIRE
  REFUND
}

enum SponsorshipTxStatus {
  AUTHORIZED
  CAPTURED
  REVOKED
  REFUNDED
}

enum TokenWalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

// Sprint A — Authorization. Tracks the role attached to the session JWT.
// CITIZEN = the public actor the rescue mission serves (lost-pet owners,
// adopters, fosters). STAFF / ADMIN gate the internal shelter surface.
enum UserRole {
  CITIZEN
  STAFF
  ADMIN
}

// ============================================================
// MODELS
// ============================================================

// Organizations act as regulatory gatekeepers
model Organization {
  orgId                String   @id @default(uuid())
  orgType              OrgType
  einNumber            String   @unique // Verified via IRS API
  stateAgLicenseNumber String? // Mandatory for states like IL (PACFA)
  charlestonCompliance Json? // Array of state IDs for solicitation legality
  animals              Animal[]

  // ── EPIC 2 backward relations (additive; non-breaking) ──
  // Sponsor (1:1 child): exactly one row when orgType=CORPORATE_SPONSOR.
  sponsor           Sponsor?
  // Token-ledger attribution (1:N): the user-token rows that name this
  // org as the sponsor who funded the redemption. Authoritative sponsor
  // economics live on SponsorshipContribution, not on this counter.
  tokenTransactions TokenTransaction[]

  @@map("organizations")
}

// Central asset ledger tracking the legal custody and health of the animal
model Animal {
  animalId             String       @id @default(uuid())
  custodianOrgId       String
  organization         Organization @relation(fields: [custodianOrgId], references: [orgId])
  breedDesignation     String       @default("Mixed Breed") // Prevents BSL insurance liability
  intakeTimestamp      DateTime     @default(now())
  strayHoldExpiresAt   DateTime?
  statutoryHoldCleared Boolean      @default(false) // Strictly controlled by Rules Engine
  medicalStatus        MedState

  // ── Adoption listing surface (additive; drives public feed + adopt pages) ──
  name          String        @default("Unnamed")
  species       String        @default("Dog")
  ageYears      Int?
  sex           String?
  personality   String?
  story         String?
  imageUrl      String?
  listingStatus ListingStatus @default(AVAILABLE)

  // Relations
  intakeRecord      IntakeRecord?
  medicalLogs       MedicalLog[]
  fundraisingWallet FundraisingWallet?

  @@map("animals")
}

// Intake split between authenticated officials and public citizens
model IntakeRecord {
  intakeId   String @id @default(uuid())
  animalId   String @unique
  animal     Animal @relation(fields: [animalId], references: [animalId])
  intakeType InType

  // Public Flow
  // Unique when present so a retry of the same waiver (same SHA-256)
  // replays the committed IntakeRecord instead of minting a second animal.
  // Postgres unique indexes allow multiple NULLs, so staff OCR batches
  // that omit a hash are unaffected.
  esignIntentHash       String? @unique
  electronicConsentFlag Boolean @default(false)
  documentSnapshotUrl   String? // AWS S3 Immutable Link

  // County Flow
  officerBadgeNumber String?
  departmentId       String?

  @@map("intake_records")
}

// ASPCA/CART aligned medical check parameters
model MedicalLog {
  logId                String  @id @default(uuid())
  animalId             String
  animal               Animal  @relation(fields: [animalId], references: [animalId])
  weightLbs            Float?
  tempPulseResp        Json? // TPR tracking
  microchipScanned     Boolean @default(false)
  vaccinesAdministered Json?
  dewormerAdministered Json?
  emergencySignsNoted  Json? // Array of symptoms (e.g. coughing, patchy hair loss)

  @@map("medical_logs")
}

// Tracks donor intent and automatically restricts fund mixing
model FundraisingWallet {
  walletId        String   @id @default(uuid())
  animalId        String   @unique
  animal          Animal   @relation(fields: [animalId], references: [animalId])
  targetAmount    Decimal
  currentBalance  Decimal  @default(0.00)
  restrictionType FundType

  @@map("fundraising_wallets")
}

// UBIT compliant vendor perk distribution
model SponsorshipPerk {
  perkId       String  @id @default(uuid())
  sponsorOrgId String
  triggerEvent Trigger
  uiRenderMode Render  @default(NEUTRAL_ACKNOWLEDGMENT) // Prevents UBIT triggers
  rewardCode   String

  @@map("sponsorship_perks")
}

// ============================================================
// EPIC 2 — Viral Token & Brand Sponsorship Gateway
// New models (User / Sponsor / TokenWallet / ViralShareVerification
// / TokenTransaction / SponsorshipContribution).
//
// INVARIANTS (enforced at the application layer; documented here
// for future migration authors):
//   * Ledger integrity: sum(signed amount) over a user's TokenTransaction
//     rows equals tokenWallets.cachedBalance (reconciliation job).
//   * Idempotency: every TokenTransaction carries a unique
//     idempotencyKey so retrying an upstream job never forks the ledger.
//   * Append-only: TokenTransaction rows are not UPDATEd except via
//     paired reversal rows (`isAdjustment=true`, `reverseOfTxnId`).
// ============================================================

// 1) User — citizen actor that owns a token wallet.
model User {
  userId         String    @id @default(uuid())
  email          String    @unique
  displayName    String
  // Sprint A — auth. scrypt-salted hash (never stored in plaintext); the
  // legacy MOCK_USERS table is retained only behind an explicit opt-in env
  // in non-production. `null` hash = not-yet-registered via credential flow.
  passwordHash   String?
  role           UserRole  @default(CITIZEN)
  marketingOptIn Boolean   @default(false)
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  tokenWallet         TokenWallet?
  tokenTransactions   TokenTransaction[]
  viralShares         ViralShareVerification[]
  contributionsAsUser SponsorshipContribution[]
  lostPetSearches     LostPetSearch[]

  // ── EPIC 3 (Tier 1.7): staged autonomous outreach, opt-in only ──
  outreachProfile OutreachProfile?
  outreachDrafts  OutreachDraft[]

  @@map("users")
}

// 2) Sponsor — 1:1 child of Organization; sponsor-economics.
model Sponsor {
  sponsorOrgId String       @id
  organization Organization @relation(fields: [sponsorOrgId], references: [orgId])

  brandDisplayName   String // "Chewy", "PetSmart"
  contactEmail       String
  // Decimal to avoid float drift on money; tokens are integer-counted.
  allocatedTokenPool Decimal   @default(0)
  consumedTokenPool  Decimal   @default(0)
  totalBudget        Decimal   @default(0)
  budgetCurrency     String    @default("USD")
  // IRC § 513(i) QSP safe-harbor — value-neutral acknowledgment copy.
  // Never rendered on user-facing surfaces; admin-only read.
  acknowledgmentCopy String?
  perkCatalogEnabled Boolean   @default(true)
  lastPoolTopUpAt    DateTime?
  createdAt          DateTime  @default(now())
  archivedAt         DateTime?

  contributions SponsorshipContribution[]

  @@map("sponsors")
}

// 3) TokenWallet — 1:1 cached running balance per User. Mutable.
// Authoritative balance is the sum of the ledger; this is a hot-cache.
model TokenWallet {
  walletId String @id @default(uuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [userId])

  cachedBalance   Int               @default(0)
  lifetimeEarned  Int               @default(0)
  lifetimeSpent   Int               @default(0)
  lifetimeExpired Int               @default(0)
  status          TokenWalletStatus @default(ACTIVE)
  frozenReason    String?
  lastActivityAt  DateTime          @default(now())
  createdAt       DateTime          @default(now())

  @@map("token_wallets")
}

// 4) ViralShareVerification — Path B (earn by sharing platform).
model ViralShareVerification {
  shareId String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [userId])

  platform         SharePlatform
  contentUrl       String?
  platformPostId   String?            @unique
  evidenceSnapshot Json?
  observedAt       DateTime?
  status           VerificationStatus @default(PENDING)
  reviewerNote     String?
  reviewedAt       DateTime?
  resolvedAction   TokenAction?
  // Inverse of TokenTransaction's "ShareResolved" — this side carries
  // the FK column. Forces 1:1: at most one settled ledger row per share.
  resolvedTxnId    String?            @unique
  resolvingTxn     TokenTransaction?  @relation("ShareResolved", fields: [resolvedTxnId], references: [txnId])
  // Inverse of TokenTransaction's "ShareForward" — no FK on this side.
  downstreamTxn    TokenTransaction[] @relation("ShareForward")

  createdAt DateTime @default(now())

  @@index([userId, platform])
  @@index([status])
  @@map("viral_share_verifications")
}

// 5) TokenTransaction (Ledger) — append-only history.
model TokenTransaction {
  txnId  String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [userId])

  direction    TokenDirection // algebraic sign of `amount`
  actionType   TokenAction
  amount       Int // always ≥ 0; sign comes from direction
  balanceAfter Int // snapshot of cachedBalance at insert time

  // Provenance — links this ledger row to the originating viral share.
  // Two named relations cross ViralShareVerification ↔ TokenTransaction:
  //   "ShareForward"  : N:1, FK lives on TokenTransaction (this side).
  //                     Use this to ask "what rows did this share spawn?"
  //   "ShareResolved" : 1:1 in reverse, FK lives on ViralShareVerification.
  //                     Use this to ask "did this share settle into exactly
  //                     one row that the share system marked complete?"
  // Prisma forbids declaring fields AND references on both sides of any
  // relation, so we annotate only one side per named relation.
  sourceViralShareId String?                 @unique
  viralShare         ViralShareVerification? @relation("ShareForward", fields: [sourceViralShareId], references: [shareId])
  // Inverse of "ShareResolved" on the ViralShareVerification side.
  resolvedShare      ViralShareVerification? @relation("ShareResolved")

  // For spend entries: the cost basis of the waived service.
  costBasisMinorUnits Int?
  currency            String? @default("USD")

  // Sponsor attribution (optional). Many ledger rows may not carry one
  // (e.g., onboarding grants); rows that DO carry one funded the
  // redemption through a specific corporate sponsor. The strict
  // sponsor-side counter lives on SponsorshipContribution.
  sponsorOrgId String?
  sponsor      Organization? @relation(fields: [sponsorOrgId], references: [orgId])

  issuedByJob    String?
  issuedByUserId String?
  notes          String?

  // External idempotency key (one ledger row per logical operation).
  idempotencyKey String @unique

  // Admin-corrected reversals. The original row stays; this row cancels it.
  isAdjustment   Boolean           @default(false)
  reverseOfTxnId String?           @unique
  reverseOf      TokenTransaction? @relation("Reversal", fields: [reverseOfTxnId], references: [txnId])
  reversal       TokenTransaction? @relation("Reversal")

  // Epic 3: a LOST_PET_SEARCH_SPEND row may back exactly one LostPetSearch
  // (1:1 nullable); the inverse relation is declared on LostPetSearch.
  lostPetSearch LostPetSearch?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sponsorOrgId])
  @@map("token_transactions")
}

// 6) SponsorshipContribution — sponsor-side bookkeeping.
// Pairs with TokenTransaction: same shape, opposite viewpoint.
// Triggers UBIT reporting on CAPTURED events under IRC § 513(i).
model SponsorshipContribution {
  contributionId String  @id @default(uuid())
  sponsorOrgId   String
  sponsor        Sponsor @relation(fields: [sponsorOrgId], references: [sponsorOrgId])

  // Null for pure top-ups, populated for redemption events.
  userId     String?
  user       User?   @relation(fields: [userId], references: [userId])
  tokenTxnId String? @unique

  type                SponsorshipTxStatus
  tokensContributed   Int
  costBasisMinorUnits Int
  currency            String              @default("USD")

  authorizedAt DateTime  @default(now())
  capturedAt   DateTime?
  revokedAt    DateTime?
  refundedAt   DateTime?
  notes        String?

  createdAt DateTime @default(now())

  @@index([sponsorOrgId, type])
  @@map("sponsorship_contributions")
}

// 8) AdoptionInterest — Sprint B adoption funnel lead row.
// One row per adopter application submitted from the public /adopt/[id]
// profile ("Adopt" / "Foster"). Public submission — no session required,
// so the lead can be captured before an adopter creates an account.
// animalId is stored as a plain string (matches dogs.json numeric ids) —
// intentionally NOT an FK so the public funnel works against the mock
// roster without coupling to the internal Animal table.
model AdoptionInterest {
  interestId String   @id @default(uuid())
  animalId   String
  animalName String
  interestType  String // "ADOPT" | "FOSTER"
  fullName      String
  email         String
  phone         String?
  message       String?
  status        String   @default("NEW")
  createdAt     DateTime @default(now())

  @@index([animalId])
  @@index([status, createdAt])
  @@map("adoption_interests")
}

// 7) LostPetSearch — Epic 3 autonomous-outreach persistence.
// One row per activated Lost Pet Search network broadcast, owned by the
// authenticated user who started it. Optional FK back to the originating
// LOST_PET_SEARCH_SPEND ledger row so /radar/[searchId] can trace the
// search to its token accounting.
model LostPetSearch {
  searchId String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [userId])

  // Captured intake fields — verbatim from /api/chat-intake.
  species       String?
  breed         String?
  colorMarkings String?
  collarId      String?
  lastSeen      String?

  // Lifecycle — default SEARCHING means "the network just got pinged".
  status LostPetSearchStatus @default(SEARCHING)

  // Optional FK back to the originating LOST_PET_SEARCH_SPEND ledger
  // row, so radar views can trace the search back to its token
  // accounting. Nullable because the FK can be absent (e.g. internal
  // tests, future promo-grants).
  debitTxnId String?           @unique
  debitTxn   TokenTransaction? @relation(fields: [debitTxnId], references: [txnId])

  activatedAt DateTime  @default(now())
  closedAt    DateTime?
  notes       String?

  @@index([userId, activatedAt])
  @@index([status, activatedAt])
  @@map("lost_pet_searches")
}

// ============================================================
// EPIC 3 (Tier 1.7) — Staged autonomous outreach (opt-in only)
// ============================================================
//
// The Idea's core: an autonomous agent that finds animal lovers and
// proactively reaches out with a nearby at-risk animal, asking them to
// donate / foster / adopt / share. The true-MVP hardening:
//   - OPT-IN ONLY: the agent NEVER cold-contacts. A citizen opts in with a
//     clear "I can help" commitment (helpAreas) + an explicit consent flag.
//   - HONEST & STAGED: outreach is generated as DRAFTs, gated by STAFF/ADMIN
//     human review, and only then marked SENT. Every row is labeled as an
//     autonomous-agent first stage — nothing pretends to be human mail.
//   - UNSUBSCRIBABLE: each profile carries a one-click unsubscribe token.

enum OutreachStatus {
  ACTIVE
  PAUSED
  UNSUBSCRIBED
}

enum OutreachDraftStatus {
  DRAFT // generated by the agent, awaiting human review
  APPROVED // staff/admin reviewed, approved for delivery
  SENT // delivered via the notification channel
  SKIPPED // reviewed and declined (no delivery)
}

enum OutreachHelpArea {
  DONATE
  FOSTER
  ADOPT
  VOLUNTEER
  SHARE
  TRANSPORT
}

model OutreachProfile {
  profileId String @id @default(uuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [userId])

  status       OutreachStatus @default(ACTIVE)
  helpAreas    OutreachHelpArea[]
  // The citizen's neighborhood/region, used by the agent to match nearby
  // at-risk animals. Stored as free text (city/zip) — no geocoding yet.
  regionLabel  String?
  consentGiven DateTime @default(now()) // explicit opt-in timestamp
  unsubscribeToken String  @unique @default(uuid())
  unsubscribedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  drafts OutreachDraft[]

  @@index([status, updatedAt])
  @@map("outreach_profiles")
}

model OutreachDraft {
  draftId   String @id @default(uuid())
  profileId String
  profile   OutreachProfile @relation(fields: [profileId], references: [profileId])
  userId    String
  user      User   @relation(fields: [userId], references: [userId])

  status OutreachDraftStatus @default(DRAFT)

  // The nearby at-risk animal the agent surfaced (nullable: the agent may
  // surface a shelter-wide urgent call, not a single animal).
  animalId String?

  // Honest, generated copy — never written by a human pretending otherwise.
  subject    String
  body       String
  helpAsk    OutreachHelpArea
  sourceNote String // e.g. "autonomous agent — stage 1, matched by region"

  reviewedByUserId String?
  reviewedAt       DateTime?
  sentAt           DateTime?
  createdAt        DateTime @default(now())

  @@index([status, createdAt])
  @@map("outreach_drafts")
}
